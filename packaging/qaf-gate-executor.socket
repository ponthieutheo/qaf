[Unit]
Description=QAF Doorman : socket de l'exécuteur (réservé au validateur)

[Socket]
ListenStream=/run/qaf-exec/executor.sock
SocketUser=qaf-exec
SocketGroup=qaf-gate
SocketMode=0660
DirectoryMode=0755
Accept=no
# Nom du descripteur reçu par l'exécuteur (LISTEN_FDNAMES, proto._fd_systemd).
FileDescriptorName=plan

[Install]
WantedBy=sockets.target

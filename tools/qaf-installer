# ---------------------------------------------------------------- prérequis
if ! essai; then
    [ "$(id -u)" = 0 ] || { echo "À lancer en root : sudo $0 $*" >&2; exit 1; }
fi
install -d -m 0755 "$(dirname "$JOURNAL")" "$R/run"

EMPREINTE_LUE=""
verifier_archive() {  # verifier_archive CHEMIN EMPREINTE MOTIF_DES_CHEMINS OBLIGATOIRE…
    local chemin=$1 attendu motif=$3 taille recu liste o
    attendu=$(printf '%s' "$2" | tr -d '[:space:]' | tr 'A-F' 'a-f')
    shift 3
    grep -Eq '^[0-9a-f]{64}$' <<< "$attendu" || \
        echec "Empreinte invalide pour $chemin (64 caractères hexadécimaux attendus)." "Rien n'a été installé."
    [ -f "$chemin" ] && [ -r "$chemin" ] || echec "Archive introuvable : $chemin." "Rien n'a été installé."
    taille=$(stat -c %s "$chemin")
    { [ "$taille" -gt 0 ] && [ "$taille" -le "$MAX" ]; } || \
        echec "Archive $chemin vide ou trop grande ($taille octets)." "Rien n'a été installé."
    recu=$(sha256sum "$chemin" | cut -d' ' -f1)
    if [ "$recu" != "$attendu" ]; then
        echec "EMPREINTES DIFFÉRENTES pour $chemin : rien n'a été installé." "attendue : $attendu" "reçue    : $recu" \
            "Ne lance rien de cette archive. Récupère-la de nouveau et revérifie l'empreinte de référence."
    fi
    dire "   $(basename "$chemin") : empreinte vérifiée, identique à celle de référence."
    liste=$(tar -tzf "$chemin") || echec "Archive $chemin illisible (pas un tar.gz)." "Rien n'a été installé."
    grep -Ev "$motif" <<< "$liste" >/dev/null && \
        echec "Archive $chemin inattendue (chemin hors de ce qu'elle doit contenir)." "Rien n'a été installé."
    grep -E '(^|/)\.\.(/|$)' <<< "$liste" >/dev/null && echec "Archive $chemin inattendue (chemin avec ..)." "Rien n'a été installé."
    for o in "$@"; do
        grep -qx "$o" <<< "$liste" || echec "Archive $chemin incomplète : $o absent (archive trop ancienne ?)." "Rien n'a été installé."
    done
    EMPREINTE_LUE=$attendu
}

prerequis_installer() {
    dire "== Prérequis"
    [ -e "$R/etc/qubes-release" ] || echec "Ce n'est pas un dom0 Qubes (pas de /etc/qubes-release)." \
        "qaf-installer se lance dans dom0, jamais dans un qube."
    if essai; then [ -e "$R/run/qubesd.sock" ] || echec "qubesd injoignable ($R/run/qubesd.sock absent)."
    elif ! { [ -S /run/qubesd.sock ] && existe qvm-prefs; }; then
        echec "Ce n'est pas un vrai dom0 : qubesd injoignable." "qaf-installer se lance dans dom0, jamais dans un qube."
    fi
    grep -Eq 'release 4\.3([.[:space:]]|$)' "$R/etc/qubes-release" || \
        echec "Version de Qubes non prise en charge : $(head -n 1 "$R/etc/qubes-release")." "QAF demande Qubes OS 4.3."
    dire "   dom0 Qubes 4.3 : $(head -n 1 "$R/etc/qubes-release")"
    local o
    for o in python3 tar sha256sum flock; do existe "$o" || echec "Outil absent dans dom0 : $o."; done

    # Empreintes demandées AVANT de lire les archives (comme qaf-update).
    if [ -z "$ATTENDU" ]; then
        read -r -p "Empreinte sha256 lue sur une source indépendante (jamais dans le qube qui a fourni l'archive) : " ATTENDU || true
    fi
    if [ "$EXT" = 1 ] && [ -z "$ATTENDU_EXT" ]; then
        read -r -p "Empreinte sha256 de l'archive d'extension, lue sur une source indépendante : " ATTENDU_EXT || true
    fi
    verifier_archive "$ARCHIVE" "$ATTENDU" '^qaf/' qaf/tools/qaf-installer qaf/packaging/install.sh qaf/packaging/qaf-zone.conf
    ATTENDU=$EMPREINTE_LUE
    ! grep -Eq '^qaf/[^/]+/extension\.conf$' <<< "$(tar -tzf "$ARCHIVE")" || \
        echec "L'archive du produit contient une extension : elle n'a pas été construite par make-dist.sh." "Rien n'a été installé."
    if [ "$EXT" = 1 ]; then
        verifier_archive "$EXT_ARCHIVE" "$ATTENDU_EXT" '^qaf/'
        ATTENDU_EXT=$EMPREINTE_LUE
        # Un seul dossier qaf/<nom>/, qui porte son extension.conf ; lue tout de suite
        # (déclarations valides) dans un dossier temporaire, avant tout changement.
        local nom liste essai_ext
        liste=$(tar -tzf "$EXT_ARCHIVE")
        nom=$(sed -n 's#^qaf/\([A-Za-z0-9_-]*\)/extension\.conf$#\1#p' <<< "$liste")
        { [ -n "$nom" ] && [ "$(grep -c . <<< "$nom")" = 1 ] && ! grep -Evq "^qaf/($nom/.*)?$" <<< "$liste"; } || \
            echec "Archive d'extension $EXT_ARCHIVE inattendue (un seul dossier qaf/<nom>/ avec son extension.conf)." \
                "Rien n'a été installé."
        essai_ext=$(mktemp -d)
        A_EFFACER=$essai_ext
        tar -xzf "$EXT_ARCHIVE" -C "$essai_ext" --no-same-owner --no-same-permissions
        lire_extension "$essai_ext"
        rm -rf "$essai_ext"
        A_EFFACER=""
    fi

    # Place : disque de dom0 et pool des qubes.
    local libre libre_dom0
    libre_dom0=$(( $(df -Pk "$R/" | awk 'NR==2{print $4}') / 1024 ))
    [ "$libre_dom0" -ge "$DOM0_MIN_MO" ] || \
        echec "Place insuffisante dans dom0 : $libre_dom0 Mio libres, $DOM0_MIN_MO Mio demandés."
    dire "   Place dans dom0 : $libre_dom0 Mio libres."
    if [ "$PLACE_MIN_GO" != 0 ]; then
        local pool taille_p usage
        pool=$(qubes-prefs default_pool 2>/dev/null || true)
        taille_p=$(qvm-pool info "$pool" 2>/dev/null | awk '$1=="size"{print $2}' || true)
        usage=$(qvm-pool info "$pool" 2>/dev/null | awk '$1=="usage"{print $2}' || true)
        [[ "$taille_p" =~ ^[0-9]+$ && "$usage" =~ ^[0-9]+$ ]] || \
            echec "Impossible de mesurer la place du pool « $pool » (qvm-pool info)." \
                "Vérifie à la main qu'il reste au moins $PLACE_MIN_GO Gio, puis relance avec QAF_PLACE_MIN_GO=0."
        libre=$(( (taille_p - usage) / 1024 / 1024 / 1024 ))
        [ "$libre" -ge "$PLACE_MIN_GO" ] || \
            echec "Place insuffisante dans le pool « $pool » : $libre Gio libres, $PLACE_MIN_GO Gio demandés." \
                "Libère de la place (qubes inutiles, anciennes sauvegardes), puis relance."
        dire "   Place dans le pool $pool : $libre Gio libres."
    fi

    [ "$(qvm-prefs "$BASE" klass 2>/dev/null || true)" = TemplateVM ] || \
        echec "Le modèle $BASE est absent." \
            "Installe-le d'abord (Qubes Template Manager, ou : sudo qubes-dom0-update --action=install qubes-template-$BASE)," \
            "puis relance. Rien n'a été installé."
    dire "   Modèle $BASE présent."
    session_ok
}

session_ok() {
    if ! [[ "$UTIL" =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] || [ "$UTIL" = root ]; then
        echec "Utilisateur de session introuvable ou invalide (« $UTIL »)." "Relance avec QAF_UTILISATEUR=nom."
    fi
    essai && return 0
    id -u "$UTIL" >/dev/null 2>&1 || echec "Utilisateur de session « $UTIL » inconnu." "Relance avec QAF_UTILISATEUR=nom."
    [ -S "/run/user/$(id -u "$UTIL")/bus" ] || \
        echec "La session graphique de « $UTIL » n'est pas ouverte." \
            "Ouvre ta session, lance la commande depuis un terminal de dom0, puis relance."
    runuser -u "$UTIL" -- sudo -n true 2>/dev/null || \
        echec "« $UTIL » n'a pas sudo sans mot de passe dans dom0 (réglage par défaut de Qubes)."
    dire "   Session graphique de $UTIL ouverte."
}

# ---------------------------------------------------------------- installer
installer() {
    prerequis_installer
    exec 9>"$R/run/qaf-installer.lock"
    flock -n 9 || echec "Un autre qaf-installer tourne déjà."

    # Étapes d'extension notées sans extension à poser ni gardée : leur --retour
    # échouerait. Refus AVANT tout changement.
    [ "$EXT" = 1 ] || charger_extension
    local inconnues
    inconnues=$(etapes_inconnues "$ETAT/etapes" | sort -u | tr '\n' ' ')
    if [ -n "$inconnues" ]; then
        echec "Étapes d'une extension installées ($inconnues), mais aucune archive d'extension n'est donnée." \
            "Relance avec --extension=ARCHIVE (et --empreinte-extension=…). Rien n'a été changé."
    fi

    dire "== Copie de l'archive vérifiée -> $LIB"
    rm -rf "$LIB.nouveau"
    install -d -m 0755 "$LIB.nouveau"
    tar -xzf "$ARCHIVE" -C "$LIB.nouveau" --no-same-owner --no-same-permissions
    install -m 0644 "$ARCHIVE" "$LIB.nouveau/qaf.tar.gz"
    # Extension à part ($LIB/extension/qaf/<nom>) : nouvelle avec --extension,
    # sinon celle d'avant est gardée (son --retour en a besoin).
    if [ "$EXT" = 1 ]; then
        install -d -m 0755 "$LIB.nouveau/extension"
        tar -xzf "$EXT_ARCHIVE" -C "$LIB.nouveau/extension" --no-same-owner --no-same-permissions
    elif [ -d "$LIB/extension" ]; then
        mv "$LIB/extension" "$LIB.nouveau/extension"
    fi
    rm -rf "$LIB"
    mv "$LIB.nouveau" "$LIB"
    charger_extension
    SRC=$LIB/qaf
    export QAF_ARCHIVE=$LIB/qaf.tar.gz
    install -d -m 0755 "$(dirname "$LANCEUR")"
    printf '#!/bin/bash\n# QAF : lanceur posé par tools/qaf-installer.\nexec bash /usr/lib/qaf-installer/qaf/tools/qaf-installer "$@"\n' > "$LANCEUR.tmp"
    chmod 0755 "$LANCEUR.tmp"
    mv "$LANCEUR.tmp" "$LANCEUR"

    # Valeur d'origine de portier.json, sauvegardée une seule fois, AVANT
    # install.sh (qui le pose s'il est absent).
    install -d -m 0755 "$ETAT/sauve"
    if [ ! -e "$ETAT/sauve/portier.json" ] && [ ! -e "$ETAT/sauve/portier.json.absent" ]; then
        if [ -f "$PORTIER" ]; then cp -p "$PORTIER" "$ETAT/sauve/portier.json"
        else : > "$ETAT/sauve/portier.json.absent"; fi
    fi
    [ -f "$ETAT/installe-le" ] || date '+%F %T' > "$ETAT/installe-le"

    detecter_materiel "$SRC"
    local etapes=$PRODUIT
    declare -F materiel_appliquer >/dev/null && etapes="$etapes materiel"
    [ "$EXT" = 1 ] && etapes="$etapes $EXT_ETAPES"
    TOTAL=$(echo "$etapes" | wc -w)

    dire ""
    dire "== Plan"
    dire "   Produit : $TOTAL étapes ; rien n'est fait sur un fichier livré par Qubes sans sauvegarde."
    if [ -n "$MATERIEL_FICHIER" ]; then
        dire "   Matériel : $MATERIEL_NOM (${MATERIEL_FICHIER#"$SRC"/})"
        [ -n "$MATERIEL_NE_JAMAIS_DEMARRER" ] && dire "   Jamais démarrés sur cette machine : $MATERIEL_NE_JAMAIS_DEMARRER"
        materiel_verifier "$R"
    else
        dire "   Matériel : machine inconnue ($(dmi sys_vendor) $(dmi product_name)), aucun profil matériel."
    fi
    dire "   Aucun paquet ajouté dans dom0 par QAF. Bureau : KDE Plasma (X11), paquet officiel de Qubes,"
    dire "   à installer par toi : sudo qubes-dom0-update kde-settings-qubes (non installé par QAF)."
    dire "   Paquets ajoutés dans les modèles : nodejs 22 (NodeSource), git, jq, Claude Code épinglé (tpl-agent) ;"
    dire "   xdotool, x11-apps, x11-utils (tpl-qaf-hand et modèles d'origine, retirés par --retour)."
    if [ "$EXT" = 1 ]; then
        dire ""
        dire "   ######################### ATTENTION : --extension #########################"
        dire "   Extension « $(basename "$EXT_DOSSIER") », étapes en plus du produit :$EXT_ETAPES"
        local l
        for l in "${EXT_AVERTIR[@]}"; do dire "   $l"; done
        dire "   Retrait : sudo qaf-installer --retour"
        dire "   ##########################################################################"
    elif [ -n "$(etapes_extension)" ]; then
        dire "   ATTENTION : l'extension d'une installation précédente est toujours là (non touchée)."
        dire "   Pour la retirer : sudo qaf-installer --retour"
    fi

    for e in $etapes; do etape e "$e"; done

    dire ""
    dire "QAF installé ($(date '+%F %T'))."
    dire "  Compte de l'agent (une fois) : icône de l'agent dans la barre de Plasma, puis Claude (un"
    dire "  terminal dans sys-agent), et connecte-toi (docs/INSTALLATION.md)."
    dire "  Bureau : Plasma (X11), seule session proposée à l'écran de connexion (Xfce reste installé, caché)."
    dire "  Tout retirer : sudo qaf-installer --retour"
    dire ""
    if ! verifier; then
        dire ""
        dire "Le contrôle de non-régression signale un écart (ci-dessus) : à regarder avant d'utiliser QAF."
        return 3
    fi
}

# ---------------------------------------------------------------- retirer
retirer() {
    exec 9>"$R/run/qaf-installer.lock"
    flock -n 9 || echec "Un autre qaf-installer tourne déjà."
    if [ ! -s "$ETAT/etapes" ] && [ ! -d "$LIB" ] && { [ "$PURGE" = 0 ] || [ ! -s "$ETAT/qubes-crees" ]; } \
            && { [ "$MATERIEL" = 0 ] || [ ! -f "$ETAT/materiel" ]; }; then
        dire "Rien à retirer : qaf-installer n'a rien installé ici."
        return 0
    fi
    SRC=$ICI
    [ -d "$LIB/qaf" ] && SRC=$LIB/qaf
    detecter_materiel "$SRC"
    charger_extension
    local q a_purger="" e inconnues session=0
    inconnues=$(etapes_inconnues "$ETAT/etapes" | tr '\n' ' ')
    [ -z "$inconnues" ] || echec "Étapes notées inconnues du produit et de l'extension gardée : $inconnues" \
        "Extension absente de $LIB/extension. Rien n'a été retiré." \
        "Réinstalle d'abord avec --extension=ARCHIVE, puis relance --retour."
    if [ "$PURGE" = 1 ]; then
        for q in $CREES; do
            grep -qx "$q" "$ETAT/qubes-crees" 2>/dev/null && qvm-check --quiet "$q" 2>/dev/null && a_purger="$a_purger $q"
        done
        dire "== --purge : en plus du retrait, suppression DÉFINITIVE des qubes créés par qaf-installer :"
        dire "   ${a_purger:- (aucun)}"
        dire "   ainsi que le journal et le registre du Doorman (/var/lib/qaf-exec…)."
        dire "   Les qubes qui existaient avant l'installation ne sont jamais supprimés."
        [ -f "$ETAT/materiel" ] && [ "$MATERIEL" = 0 ] && \
            dire "   Gardé : masquage des disques internes, retrait par --retour --materiel."
        local rep=""
        read -r -p "Tape PURGER pour confirmer : " rep || true
        [ "$rep" = PURGER ] || { dire "Pas de confirmation : rien n'a été fait."; return 1; }
    fi
    for e in $(cat "$ETAT/etapes" 2>/dev/null || true); do
        case "$e" in securite) session=1 ;; esac
        [ "${EXT_QUI[$e]:-}" = session ] && session=1
    done
    [ "$session" = 1 ] && session_ok
    local etapes
    etapes=$(tac "$ETAT/etapes" 2>/dev/null || true)
    TOTAL=$(echo "$etapes" | wc -w)
    for e in $etapes; do etape r "$e"; done
    [ "$MATERIEL" = 1 ] && retirer_materiel
    if [ -n "$a_purger" ]; then
        dire ""
        dire "== Suppression des qubes créés :$a_purger"
        for q in $a_purger; do
            qvm-shutdown --wait "$q" 2>/dev/null || true
            qvm-remove -f "$q" || echec "Suppression de $q impossible (encore utilisé ? un jetable de qaf-dvm tourne ?)." \
                "Le reste est retiré. Corrige, puis : sudo qaf-installer --retour --purge"
            grep -vx "$q" "$ETAT/qubes-crees" > "$ETAT/qubes-crees.tmp" || true
            mv "$ETAT/qubes-crees.tmp" "$ETAT/qubes-crees"
            dire "   $q supprimé."
        done
    fi
    dire ""
    dire "== Fichiers de l'installateur"
    rm -f "$LANCEUR"
    rm -rf "$LIB" "$LIB.nouveau"
    if { [ "$PURGE" = 1 ] || [ ! -s "$ETAT/qubes-crees" ]; } && [ ! -f "$ETAT/materiel" ]; then
        rm -rf "$ETAT"
    else
        # Gardés : la liste des qubes créés (un --retour --purge plus tard les
        # retrouve) et l'état de la couche matériel (--retour --materiel).
        [ "$PURGE" = 1 ] && rm -f "$ETAT/qubes-crees"
        find "$ETAT" -mindepth 1 ! -name qubes-crees ! -name materiel -exec rm -rf {} + 2>/dev/null || true
    fi
    dire "QAF retiré ($(date '+%F %T')). Journal gardé : $JOURNAL"
    [ "$PURGE" = 1 ] || dire "Qubes créés gardés (sudo qaf-installer --retour --purge pour les supprimer)."
    [ -f "$ETAT/materiel" ] && dire "Profil matériel gardé : disques internes toujours masqués (pour le retirer, depuis l'archive"         && dire "extraite : sudo bash qaf/tools/qaf-installer --retour --materiel)."
    [ -f "$ETAT/materiel" ] && dire "Note : --retour seul ne rend donc pas la machine strictement identique (docs/INSTALLATION.md)."
    dire ""
    verifier || true
}

principal() {
    set -e
    dire ""
    dire "######## qaf-installer $MODE $* — $(date '+%F %T')"
    if [ "$MODE" = installer ]; then installer; else retirer; fi
}
set +e
principal "$@" 2>&1 | tee -a "$JOURNAL"
rc=${PIPESTATUS[0]}
exit "$rc"
